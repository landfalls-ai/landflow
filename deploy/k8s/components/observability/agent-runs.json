  {
   "type": "timeseries",
   "title": "Agent Substrate: restore and checkpoint p95",
   "description": "Resuming a paused kagent agent restores its actor from a snapshot; every finished request checkpoints it",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(ate_actor_restore_duration_seconds_bucket[$__rate_interval])))",
     "legendFormat": "restore"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(ate_actor_checkpoint_duration_seconds_bucket[$__rate_interval])))",
     "legendFormat": "checkpoint"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(ate_scheduler_assignment_duration_seconds_bucket[$__rate_interval])))",
     "legendFormat": "scheduling"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "auto"
