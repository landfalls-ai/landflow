   }
  },
  {
   "type": "timeseries",
   "title": "Latency p95",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(landflow_agent_run_duration_milliseconds_bucket[$__rate_interval])))",
     "legendFormat": "Landflow agent run"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(landflow_agent_tool_duration_milliseconds_bucket[$__rate_interval])))",
     "legendFormat": "Landflow tool call"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(landflow_a2a_call_duration_milliseconds_bucket[$__rate_interval])))",
     "legendFormat": "A2A call (until the task settles)"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(gen_ai_invoke_agent_duration_seconds_bucket[$__rate_interval])))",
     "legendFormat": "kagent invoke_agent"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "auto"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 11,
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   }
  },
