  {
   "type": "table",
   "title": "Recent agent runs (traces)",
   "description": "Each Landflow agent run: open one to see the whole path, the remote agent's spans included",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "tableType": "traces",
     "limit": 20,
     "query": "{ resource.service.name = \"landflow-host\" && span.gen_ai.operation.name = \"invoke_agent\" && kind = internal }"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "id": 15,
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 12,
    "h": 9
   }
  },
