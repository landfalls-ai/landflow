  {
   "type": "table",
   "title": "Landflow agent tool calls",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (gen_ai_agent_name, gen_ai_tool_name, landflow_agent_tool_kind, landflow_outcome) (increase(landflow_agent_tool_calls_total[$__range])) > 0",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value": "calls"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "id": 9,
   "gridPos": {
    "x": 0,
    "y": 12,
