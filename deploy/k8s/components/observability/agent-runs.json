{
 "uid": "landflow-agent-runs",
 "title": "Landflow \u00b7 agent runs",
 "tags": [
  "landflow",
  "agents",
  "kagent"
 ],
 "description": "Landflow agents, the remote A2A agents they call (kagent) and Agent Substrate: runs, tool calls, approvals, tokens, latency, traces and logs",
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "refresh": "30s",
 "editable": true,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "type": "stat",
   "title": "Agent runs",
   "description": "Runs of Landflow agents in the range (one per message, schedule fire or resumed approval)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(landflow_agent_runs_total[$__range]))",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": []
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
