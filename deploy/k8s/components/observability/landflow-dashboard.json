    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (landflow_limiter) (rate(landflow_auth_limited_total[5m]))",
     "legendFormat": "sign-in {{landflow_limiter}}"
    }
   ]
  },
