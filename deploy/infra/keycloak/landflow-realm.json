{
  "realm": "landflow",
  "displayName": "Landflow (dev)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "landflow-admin", "description": "Landflow administrator (test realm)" },
      { "name": "landflow-editor", "description": "Landflow workflow editor (test realm)" }
    ]
  },
  "clients": [
    {
      "clientId": "landflow",
      "name": "Landflow",
      "description": "Landflow host (dev server on :3000 and the dockerised host on :53000)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "landflow-dev-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:3000/api/auth/oidc/callback",
        "http://127.0.0.1:3000/api/auth/oidc/callback",
        "http://localhost:53000/api/auth/oidc/callback",
        "http://127.0.0.1:53000/api/auth/oidc/callback",
        "http://localhost:3000/api/oauth2/callback",
        "http://127.0.0.1:3000/api/oauth2/callback",
        "http://localhost:53000/api/oauth2/callback",
        "http://127.0.0.1:53000/api/oauth2/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000",
        "http://localhost:53000",
        "http://127.0.0.1:53000"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*##http://127.0.0.1:3000/*##http://localhost:53000/*##http://127.0.0.1:53000/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "http://localhost:3000/api/auth/saml/metadata",
      "name": "Landflow (SAML)",
      "description": "Landflow SAML 2.0 sign-in: the SP entity id of the dev server on :3000 (the dockerised host on :53000 sets LANDFLOW_SAML_ISSUER to it)",
      "protocol": "saml",
      "enabled": true,
      "publicClient": false,
      "frontchannelLogout": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/api/auth/saml/*",
        "http://127.0.0.1:3000/api/auth/saml/*",
        "http://localhost:53000/api/auth/saml/*",
        "http://127.0.0.1:53000/api/auth/saml/*"
      ],
      "attributes": {
        "saml.authnstatement": "true",
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.force.post.binding": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "persistent",
        "saml_single_logout_service_url_redirect": "http://localhost:3000/api/auth/saml/logout",
        "saml_single_logout_service_url_post": "http://localhost:3000/api/auth/saml/logout"
      },
      "protocolMappers": [
        { "name": "email", "protocol": "saml", "protocolMapper": "saml-user-property-mapper", "consentRequired": false, "config": { "user.attribute": "email", "friendly.name": "email", "attribute.name": "email", "attribute.nameformat": "Basic" } },
        { "name": "firstName", "protocol": "saml", "protocolMapper": "saml-user-property-mapper", "consentRequired": false, "config": { "user.attribute": "firstName", "friendly.name": "givenName", "attribute.name": "firstName", "attribute.nameformat": "Basic" } },
        { "name": "lastName", "protocol": "saml", "protocolMapper": "saml-user-property-mapper", "consentRequired": false, "config": { "user.attribute": "lastName", "friendly.name": "surname", "attribute.name": "lastName", "attribute.nameformat": "Basic" } },
        { "name": "roles", "protocol": "saml", "protocolMapper": "saml-role-list-mapper", "consentRequired": false, "config": { "single": "true", "attribute.name": "roles", "attribute.nameformat": "Basic", "friendly.name": "roles" } },
        { "name": "groups", "protocol": "saml", "protocolMapper": "saml-group-membership-mapper", "consentRequired": false, "config": { "single": "true", "full.path": "false", "attribute.name": "groups", "attribute.nameformat": "Basic", "friendly.name": "groups" } }
      ]
    },
    {
      "clientId": "urn:landflow:test:saml-encrypted",
      "name": "Landflow (SAML, encrypted assertions, tests)",
      "description": "Encrypted SAML assertions (test/saml.integration.test.ts): signed, then encrypted to the test-only cert in test/fixtures/saml/sp-encryption.cert.pem (RSA-OAEP, AES-256-GCM)",
      "protocol": "saml",
      "enabled": true,
      "publicClient": false,
      "frontchannelLogout": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/api/auth/saml/*",
        "http://127.0.0.1:3000/api/auth/saml/*"
      ],
      "attributes": {
        "saml.authnstatement": "true",
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml.client.signature": "false",
        "saml.encrypt": "true",
        "saml.encryption.certificate": "",
        "saml.encryption.algorithm": "http://www.w3.org/2009/xmlenc11#aes256-gcm",
        "saml.encryption.keyAlgorithm": "http://www.w3.org/2001/04/xmlenc#rsa-oaep-mgf1p",
        "saml.encryption.digestMethod": "http://www.w3.org/2000/09/xmldsig#sha1",
        "saml.force.post.binding": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "persistent",
        "saml_single_logout_service_url_redirect": "http://localhost:3000/api/auth/saml/logout",
        "saml_single_logout_service_url_post": "http://localhost:3000/api/auth/saml/logout"
      },
      "protocolMappers": [
        { "name": "email", "protocol": "saml", "protocolMapper": "saml-user-property-mapper", "consentRequired": false, "config": { "user.attribute": "email", "friendly.name": "email", "attribute.name": "email", "attribute.nameformat": "Basic" } },
        { "name": "firstName", "protocol": "saml", "protocolMapper": "saml-user-property-mapper", "consentRequired": false, "config": { "user.attribute": "firstName", "friendly.name": "givenName", "attribute.name": "firstName", "attribute.nameformat": "Basic" } },
        { "name": "lastName", "protocol": "saml", "protocolMapper": "saml-user-property-mapper", "consentRequired": false, "config": { "user.attribute": "lastName", "friendly.name": "surname", "attribute.name": "lastName", "attribute.nameformat": "Basic" } },
        { "name": "roles", "protocol": "saml", "protocolMapper": "saml-role-list-mapper", "consentRequired": false, "config": { "single": "true", "attribute.name": "roles", "attribute.nameformat": "Basic", "friendly.name": "roles" } },
        { "name": "groups", "protocol": "saml", "protocolMapper": "saml-group-membership-mapper", "consentRequired": false, "config": { "single": "true", "full.path": "false", "attribute.name": "groups", "attribute.nameformat": "Basic", "friendly.name": "groups" } }
      ]
    }
  ],
  "groups": [{ "name": "data-team" }],
  "users": [
    {
      "username": "alice",
      "email": "alice@landflow.test",
      "firstName": "Alice",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "alice-test-only", "temporary": false }],
      "realmRoles": ["default-roles-landflow", "landflow-admin"]
    },
    {
      "username": "bob",
      "email": "bob@landflow.test",
      "firstName": "Bob",
      "lastName": "Editor",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "bob-test-only", "temporary": false }],
      "realmRoles": ["default-roles-landflow", "landflow-editor"],
      "groups": ["/data-team"]
    }
  ]
}
