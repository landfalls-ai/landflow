# Landflow Docker settings. Every value here is also the built-in default in the compose files,
# so this file is optional: copy it to deploy/.env only to change something.
#
#   cp deploy/.env.example deploy/.env
#
# All credentials below are for local development and tests only. Never reuse them anywhere real.

# Interface the published ports bind to. 127.0.0.1 keeps everything off the LAN; 0.0.0.0 exposes it.
LANDFLOW_BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------- infra stack (compose.infra.yml)

# Postgres 16 + pgvector. Databases: landflow (app) and landflow_test (integration tests).
LANDFLOW_POSTGRES_PORT=55432
LANDFLOW_POSTGRES_USER=landflow
LANDFLOW_POSTGRES_PASSWORD=landflow-dev-only
LANDFLOW_POSTGRES_DB=landflow

# Valkey 8 (Redis protocol), for the future queue mode and the Redis node.
LANDFLOW_VALKEY_PORT=56379

# Mailpit: SMTP sink (accepts any user/password) and web UI.
LANDFLOW_SMTP_PORT=51025
LANDFLOW_MAIL_UI_PORT=58025

# MinIO (S3 API + console). A "landflow" bucket is created on start.
LANDFLOW_MINIO_PORT=59000
LANDFLOW_MINIO_CONSOLE_PORT=59001
LANDFLOW_MINIO_ROOT_USER=landflow
LANDFLOW_MINIO_ROOT_PASSWORD=landflow-dev-only
LANDFLOW_MINIO_BUCKET=landflow

# OpenBao in dev mode (in-memory, unsealed). KV v2 is mounted at landflow/.
LANDFLOW_OPENBAO_PORT=58200
LANDFLOW_OPENBAO_ROOT_TOKEN=landflow-dev-root-token

# LocalStack 4.9 (profile "aws"): AWS Secrets Manager for the external secrets tests; dummy credentials only.
LANDFLOW_LOCALSTACK_PORT=54566

# Keycloak 26.0 (profile "auth"): realm "landflow", confidential client "landflow".
LANDFLOW_KEYCLOAK_PORT=58080
LANDFLOW_KEYCLOAK_ADMIN=admin
LANDFLOW_KEYCLOAK_ADMIN_PASSWORD=admin-dev-only

# Jaeger 2 (profile "observability"): UI and OTLP receivers (4318 is taken on this machine).
LANDFLOW_JAEGER_UI_PORT=56686
LANDFLOW_JAEGER_OTLP_HTTP_PORT=54318
LANDFLOW_JAEGER_OTLP_GRPC_PORT=54317

# MySQL 8.4 (profile "mysql"), for the databases plugin's integration tests.
LANDFLOW_MYSQL_PORT=53306
LANDFLOW_MYSQL_USER=landflow
LANDFLOW_MYSQL_PASSWORD=landflow-dev-only
LANDFLOW_MYSQL_ROOT_PASSWORD=landflow-root-dev-only
LANDFLOW_MYSQL_DATABASE=landflow_test

# GreenMail (profile "mail"): IMAP and SMTP test server for the Email Trigger (IMAP).
LANDFLOW_GREENMAIL_IMAP_PORT=53143
LANDFLOW_GREENMAIL_SMTP_PORT=53025

# ---------------------------------------------------------------- app stack (compose.yml)

# Host port of the dockerised Landflow (the dev server keeps :3000).
LANDFLOW_HOST_PORT=53000
# The owner boot creates in an empty data volume (sign in with these; smoke.sh does). Blank both to use /setup.
LANDFLOW_OWNER_EMAIL=owner@landflow.test
LANDFLOW_OWNER_PASSWORD=landflow-dev-only
# Image names: <prefix>/host:<tag>, <prefix>/plugin-<name>:<tag>.
LANDFLOW_IMAGE_PREFIX=landflow
LANDFLOW_IMAGE_TAG=dev
# Credentials-vault key: 64 hex characters or a passphrase. Empty: generated into the data volume.
LANDFLOW_ENCRYPTION_KEY=
LANDFLOW_LOG_LEVEL=info
# Ollama on the Mac, for the AI flow builder and assistant.
LANDFLOW_OLLAMA_URL=http://host.docker.internal:11434
# OTLP/HTTP endpoint for the host and every plugin. Empty: no export. With the observability profile:
#   http://host.docker.internal:54318   (always works)
#   http://jaeger:4318                  (with compose.infra-link.yml)
LANDFLOW_OTLP_ENDPOINT=
# Trace links in the execution view.
LANDFLOW_TRACE_URL=http://localhost:56686/trace/{traceId}

# Code runner (sandboxed Code node, see deploy/README.md "Code runner"). Shared secret between the host and the
# runner; the dev server uses the same value with LANDFLOW_CODE_RUNNER_URL=http://127.0.0.1:53300.
LANDFLOW_CODE_RUNNER_SECRET=landflow-code-runner-dev-only
# Port on the Mac for the dev server on :3000 (code-runner-port forwards it to code-runner:7300).
LANDFLOW_CODE_RUNNER_PORT=53300
# The container's limits, and each snippet's.
LANDFLOW_CODE_RUNNER_MEM_LIMIT=1g
LANDFLOW_CODE_RUNNER_CPUS=2
LANDFLOW_CODE_RUNNER_CONCURRENCY=2
LANDFLOW_CODE_RUNNER_TIMEOUT_MS=60000
LANDFLOW_CODE_RUNNER_MEMORY_MB=256
# true: the dockerised host also runs JavaScript Code nodes in-process (node:vm, not isolated).
LANDFLOW_CODE_IN_PROCESS=false

# Queue mode stack (compose.queue.yml, deploy/README.md "Queue mode"): ports on the Mac, the database in the infra
# Postgres, the Valkey key prefix, failover timings, worker concurrency and the shared secrets (development values).
LANDFLOW_QUEUE_PORT=53080
LANDFLOW_QUEUE_MAIN1_PORT=53081
LANDFLOW_QUEUE_MAIN2_PORT=53082
LANDFLOW_QUEUE_WORKER1_PORT=55691
LANDFLOW_QUEUE_WORKER2_PORT=55692
LANDFLOW_QUEUE_DATABASE=landflow_queue
LANDFLOW_QUEUE_PREFIX=landflow-queue
LANDFLOW_LEADER_TTL_SECONDS=10
LANDFLOW_STALLED_SECONDS=30
LANDFLOW_WORKER_CONCURRENCY=10
LANDFLOW_QUEUE_ENCRYPTION_KEY=landflow-queue-dev-only-encryption-key
LANDFLOW_QUEUE_BINARY_SECRET=landflow-queue-dev-only-binary-secret
# OTLP/HTTP for the queue stack's mains and workers (it is on the infra network): http://jaeger:4318
LANDFLOW_QUEUE_OTLP_ENDPOINT=
