# Landflow Docker settings. Every value here is also the built-in default in the compose files,
# so this file is optional: copy it to deploy/.env only to change something.
#
#   cp deploy/.env.example deploy/.env
#
# All credentials below are for local development and tests only. Never reuse them anywhere real.

# Interface the published ports bind to. 127.0.0.1 keeps everything off the LAN; 0.0.0.0 exposes it.
LANDFLOW_BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------- infra stack (compose.infra.yml)

# Postgres 16 + pgvector. Databases: landflow (app) and landflow_test (integration tests).
LANDFLOW_POSTGRES_PORT=55432
LANDFLOW_POSTGRES_USER=landflow
LANDFLOW_POSTGRES_PASSWORD=landflow-dev-only
LANDFLOW_POSTGRES_DB=landflow

# Valkey 8 (Redis protocol), for the future queue mode and the Redis node.
LANDFLOW_VALKEY_PORT=56379

# Mailpit: SMTP sink (accepts any user/password) and web UI.
LANDFLOW_SMTP_PORT=51025
LANDFLOW_MAIL_UI_PORT=58025

# MinIO (S3 API + console). A "landflow" bucket is created on start.
LANDFLOW_MINIO_PORT=59000
LANDFLOW_MINIO_CONSOLE_PORT=59001
LANDFLOW_MINIO_ROOT_USER=landflow
LANDFLOW_MINIO_ROOT_PASSWORD=landflow-dev-only
LANDFLOW_MINIO_BUCKET=landflow

# OpenBao in dev mode (in-memory, unsealed). KV v2 is mounted at landflow/.
LANDFLOW_OPENBAO_PORT=58200
LANDFLOW_OPENBAO_ROOT_TOKEN=landflow-dev-root-token

# LocalStack 4.9 (profile "aws"): AWS Secrets Manager for the external secrets tests; dummy credentials only.
LANDFLOW_LOCALSTACK_PORT=54566

# Keycloak 26.0 (profile "auth"): realm "landflow", confidential client "landflow".
LANDFLOW_KEYCLOAK_PORT=58080
LANDFLOW_KEYCLOAK_ADMIN=admin
LANDFLOW_KEYCLOAK_ADMIN_PASSWORD=admin-dev-only

# Jaeger 2 (profile "observability"): UI and OTLP receivers (4318 is taken on this machine).
LANDFLOW_JAEGER_UI_PORT=56686
LANDFLOW_JAEGER_OTLP_HTTP_PORT=54318
LANDFLOW_JAEGER_OTLP_GRPC_PORT=54317

# MySQL 8.4 (profile "mysql"), for the databases plugin's integration tests.
LANDFLOW_MYSQL_PORT=53306
LANDFLOW_MYSQL_USER=landflow
LANDFLOW_MYSQL_PASSWORD=landflow-dev-only
LANDFLOW_MYSQL_ROOT_PASSWORD=landflow-root-dev-only
LANDFLOW_MYSQL_DATABASE=landflow_test

# GreenMail (profile "mail"): IMAP and SMTP test server for the Email Trigger (IMAP).
LANDFLOW_GREENMAIL_IMAP_PORT=53143
LANDFLOW_GREENMAIL_SMTP_PORT=53025

# ---------------------------------------------------------------- app stack (compose.yml)

# Host port of the dockerised Landflow (the dev server keeps :3000).
LANDFLOW_HOST_PORT=53000
# The owner boot creates in an empty data volume (sign in with these; smoke.sh does). Blank both to use /setup.
LANDFLOW_OWNER_EMAIL=owner@landflow.test
LANDFLOW_OWNER_PASSWORD=landflow-dev-only
# Image names: <prefix>/host:<tag>, <prefix>/plugin-<name>:<tag>.
LANDFLOW_IMAGE_PREFIX=landflow
LANDFLOW_IMAGE_TAG=dev
# Credentials-vault key: 64 hex characters or a passphrase. Empty: generated into the data volume.
LANDFLOW_ENCRYPTION_KEY=
LANDFLOW_LOG_LEVEL=info
# Ollama on the Mac, for the AI flow builder and assistant.
LANDFLOW_OLLAMA_URL=http://host.docker.internal:11434
# OTLP/HTTP endpoint for the host and every plugin. Empty: no export. With the observability profile:
#   http://host.docker.internal:54318   (always works)
#   http://jaeger:4318                  (with compose.infra-link.yml)
LANDFLOW_OTLP_ENDPOINT=
# Trace links in the execution view.
LANDFLOW_TRACE_URL=http://localhost:56686/trace/{traceId}

# Code runner (sandboxed Code node, see docs/deployment.md "Code runner"). Shared secret between the host and the
# runner; the dev server uses the same value with LANDFLOW_CODE_RUNNER_URL=http://127.0.0.1:53300.
LANDFLOW_CODE_RUNNER_SECRET=landflow-code-runner-dev-only
# Port on the Mac for the dev server on :3000 (code-runner-port forwards it to code-runner:7300).
LANDFLOW_CODE_RUNNER_PORT=53300
# The container's limits, and each snippet's.
LANDFLOW_CODE_RUNNER_MEM_LIMIT=1g
LANDFLOW_CODE_RUNNER_CPUS=2
LANDFLOW_CODE_RUNNER_CONCURRENCY=2
LANDFLOW_CODE_RUNNER_TIMEOUT_MS=60000
LANDFLOW_CODE_RUNNER_MEMORY_MB=256
# Files a snippet creates with prepareBinaryData (bytes, before base64); raise the runner's request and output caps with it.
LANDFLOW_CODE_RUNNER_MAX_BINARY_BYTES=6291456
# true: the dockerised host also runs JavaScript Code nodes in-process (node:vm, not isolated).
LANDFLOW_CODE_IN_PROCESS=false

# Queue mode stack (compose.queue.yml, docs/deployment.md "Queue mode"): ports on the Mac, the database in the infra
# Postgres, the Valkey key prefix, failover timings, worker concurrency and the shared secrets (development values).
LANDFLOW_QUEUE_PORT=53080
LANDFLOW_QUEUE_MAIN1_PORT=53081
LANDFLOW_QUEUE_MAIN2_PORT=53082
LANDFLOW_QUEUE_WORKER1_PORT=55691
LANDFLOW_QUEUE_WORKER2_PORT=55692
LANDFLOW_QUEUE_DATABASE=landflow_queue
LANDFLOW_QUEUE_PREFIX=landflow-queue
LANDFLOW_LEADER_TTL_SECONDS=10
LANDFLOW_STALLED_SECONDS=30
LANDFLOW_WORKER_CONCURRENCY=10
LANDFLOW_QUEUE_ENCRYPTION_KEY=landflow-queue-dev-only-encryption-key
LANDFLOW_QUEUE_BINARY_SECRET=landflow-queue-dev-only-binary-secret
# OTLP/HTTP for the queue stack's mains and workers (it is on the infra network): http://jaeger:4318
LANDFLOW_QUEUE_OTLP_ENDPOINT=

# ---------------------------------------------------------------- message brokers and the MCP gateway (compose.infra.yml)
# One compose profile each (docs/transports.md, docs/deployment.md "Message brokers"); all bound to LANDFLOW_BIND_ADDR.

# Kafka 4.3 in KRaft mode with share groups (profile "kafka"). From the Mac: localhost:59092; in-network: kafka:9092.
LANDFLOW_KAFKA_PORT=59092
# RabbitMQ 4.4 with the management plugin (profile "rabbitmq").
LANDFLOW_RABBITMQ_PORT=55672
LANDFLOW_RABBITMQ_MANAGEMENT_PORT=55673
LANDFLOW_RABBITMQ_USER=landflow
LANDFLOW_RABBITMQ_PASSWORD=landflow-dev-only
# NATS 2.15 with JetStream (profile "nats"): client port and the monitoring endpoint.
LANDFLOW_NATS_PORT=54222
LANDFLOW_NATS_MONITOR_PORT=58222
# Mosquitto 2.1, MQTT 5, anonymous (profile "mqtt").
LANDFLOW_MQTT_PORT=51883
# ActiveMQ Artemis 2.44 (profile "artemis"): the AMQP 1.0 (multi-protocol) acceptor and the web console.
LANDFLOW_ARTEMIS_AMQP_PORT=55674
LANDFLOW_ARTEMIS_CONSOLE_PORT=58161
LANDFLOW_ARTEMIS_USER=landflow
LANDFLOW_ARTEMIS_PASSWORD=landflow-dev-only
# Pulsar 4.2 standalone (profile "pulsar"): binary protocol and the admin REST API.
LANDFLOW_PULSAR_PORT=56650
LANDFLOW_PULSAR_ADMIN_PORT=58180
# Google Pub/Sub emulator (profile "pubsub"): PUBSUB_EMULATOR_HOST=127.0.0.1:58085, no credentials.
LANDFLOW_PUBSUB_PORT=58085
LANDFLOW_PUBSUB_PROJECT=landflow-dev
# Azure Service Bus emulator (profile "servicebus"): AMQP and the management/health port; its SQL backend's sa password
# (must satisfy SQL Server's policy). Starting the profile accepts the Microsoft EULAs for the emulator and SQL.
LANDFLOW_SERVICEBUS_PORT=55675
LANDFLOW_SERVICEBUS_HTTP_PORT=55300
LANDFLOW_SERVICEBUS_SQL_PASSWORD=Landflow-dev-only1
LANDFLOW_SERVICEBUS_ACCEPT_EULA=Y
# agentgateway 1.6, the bundled MCP gateway (profile "mcp-gateway"): the MCP listener (/mcp) and the admin API + UI
# (no authentication: keep it on 127.0.0.1). The dev server talks to the admin API at LANDFLOW_MCP_GATEWAY_ADMIN_URL.
LANDFLOW_MCP_GATEWAY_PORT=54000
LANDFLOW_MCP_GATEWAY_ADMIN_PORT=55000
# MCP identity (docs/transports.md "Sign-in and identity"; apps/web/src/lib/server/mcp/identity.ts). LANDFLOW_MCP_GATEWAY:
# bundled (the agentgateway sidecar, default), file (a gateway of its own that reads the targets file) or off. The secret is
# what the gateway sends the host as `x-landflow-gateway` (backendAuth) so the host trusts the caller identity headers it
# sets; at least 16 characters, dev value only. The public URL is where agents connect (it goes into server.json
# `remotes[]` and the token audiences); the admin URL is where the host writes targets (wave T3). The namespace prefixes
# the registry names (`<namespace>/<pluginId>`). LANDFLOW_MCP_IDP_AUDIENCE (optional, comma-separated) adds audiences the
# identity provider's access tokens may carry when they call the host directly (the resource URLs are always accepted).
# LANDFLOW_MCP_GATEWAY_ACCEPT_IDP (auto; `off` disables): when LANDFLOW_OIDC_ISSUER is set, the synced routes also accept the
# identity provider's tokens next to Landflow's (agentgateway `jwtAuth` with two providers; docs/mcp-gateway.md).
LANDFLOW_MCP_GATEWAY=bundled
LANDFLOW_MCP_GATEWAY_SECRET=landflow-mcp-gateway-dev-only-secret
LANDFLOW_MCP_GATEWAY_PUBLIC_URL=http://127.0.0.1:54000
LANDFLOW_MCP_GATEWAY_ADMIN_URL=http://127.0.0.1:55000
LANDFLOW_MCP_NAMESPACE=local.landflow
#LANDFLOW_MCP_IDP_AUDIENCE=
# The gateway sync (apps/web/src/lib/server/mcp/gateway-sync.ts) writes one target per exposed plugin (plus `core`) into the
# gateway. LANDFLOW_MCP_GATEWAY_HOST_URL is how the gateway reaches this host: the dev gateway runs in Docker and the dev
# server on the Mac (default http://host.docker.internal:3000); a compose/Kubernetes sidecar shares the host's network
# namespace (http://127.0.0.1:3000, set in compose.yml). LANDFLOW_MCP_GATEWAY_FILE is the config file written in mode
# `file` (default <data dir>/mcp-gateway.yaml). LANDFLOW_MCP_GATEWAY_ROUTES=off skips the per-plugin routes
# (/mcp/plugins/<plugin>, …/server-card); LANDFLOW_MCP_GATEWAY_ROUTE_POLICIES is a JSON object of agentgateway route
# policies merged into each per-plugin route (the same mcpAuthentication as the base config's /mcp, when sign-in is on;
# a jwks url at the host's own /api/mcp/jwks is written inline, so the stored routes don't need the host to start).
# With the dev gateway's Landflow-token sign-in (mcp-gateway/compose.tokens.yml), the dev server on :3000 sets the
# value in the comment below.
#LANDFLOW_MCP_GATEWAY_HOST_URL=http://host.docker.internal:3000
#LANDFLOW_MCP_GATEWAY_FILE=
#LANDFLOW_MCP_GATEWAY_ROUTES=on
#LANDFLOW_MCP_GATEWAY_ROUTE_POLICIES=
# {"mcpAuthentication":{"mode":"optional","issuer":"http://localhost:3000","audiences":["http://127.0.0.1:54000/mcp"],"jwks":{"url":"http://host.docker.internal:3000/api/mcp/jwks"}}}
