          "default": ""
        }
      ]
    },
    {
      "name": "notATool",
      "displayName": "Not a tool",
      "description": "An action node without usableAsTool is left out.",
      "version": 1,
      "kind": "action",
      "inputs": [
        {
          "type": "main"
        }
      ],
      "outputs": [
