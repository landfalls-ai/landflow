      "kind": "action",
      "usableAsTool": true,
      "inputs": [
        {
          "type": "main"
        }
      ],
      "outputs": [
        {
          "type": "main"
        }
      ],
      "properties": [
        {
          "name": "operation",
          "displayName": "Operation",
