{
  "protocol": "landflow.plugin/v1",
  "plugin": {
    "id": "py-insights",
    "name": "Insights",
    "version": "0.1.0",
    "language": "python",
    "sdk": {
      "name": "landflow-sdk-python",
      "version": "0.1.0"
    },
    "description": "Dependency-free data and text insights: field statistics, lexicon sentiment, keyword extraction.",
    "icon": "data:image/svg+xml;base64,",
    "color": "#f59e0b",
    "author": "Landflow"
  },
  "nodes": [
    {
      "name": "stats",
      "displayName": "Field Statistics",
      "description": "Aggregate a numeric field across all items: count, sum, mean, median, min, max, stdev (sample)",
      "version": 1,
      "kind": "action",
      "categories": [
        "Data"
      ],
      "icon": "data:image/svg+xml;base64,",
      "color": "#f59e0b",
      "subtitle": "{{field}}",
      "inputs": [
        {
          "type": "main"
        }
      ],
      "outputs": [
        {
          "type": "main"
        }
      ],
      "keywords": [
        "aggregate",
        "summarize",
        "average",
        "mean",
        "median",
        "sum",
        "group by"
      ],
      "properties": [
        {
          "name": "field",
          "displayName": "Field",
          "type": "string",
          "default": "value",
          "required": true,
          "placeholder": "e.g. price or order.total",
          "description": "Numeric field to aggregate (dot paths allowed). Non-numeric values are skipped."
        },
        {
          "name": "groupBy",
          "displayName": "Group By",
          "type": "string",
          "default": "",
          "placeholder": "e.g. category",
          "description": "Optional field to group by. When set, one item is emitted per group."
        }
      ]
    },
    {
      "name": "sentiment",
      "displayName": "Sentiment",
      "description": "Score the sentiment of a text field (-1..1) with a built-in lexicon",
      "version": 1,
      "kind": "action",
      "categories": [
        "AI",
        "Text"
      ],
      "icon": "data:image/svg+xml;base64,",
      "color": "#f97316",
      "subtitle": "{{field}}",
      "inputs": [
        {
          "type": "main"
        }
      ],
      "outputs": [
        {
          "type": "main"
        }
      ],
      "usableAsTool": true,
      "toolDescription": "Analyze the emotional tone of a piece of text. Pass the text in the `text` argument. Returns `sentiment.score` from -1 (very negative) to 1 (very positive), `sentiment.label` (positive, neutral or negative) and `sentiment.matched`, the sentiment words that drove the score (negations such as 'not good' are handled). Deterministic and fast (lexicon-based, English); use it to triage reviews, support tickets or messages by tone, not for sarcasm.",
      "keywords": [
        "sentiment",
        "tone",
        "emotion",
        "polarity",
        "opinion",
        "review"
      ],
      "properties": [
        {
          "name": "field",
          "displayName": "Text Field",
          "type": "string",
          "default": "text",
          "required": true,
          "description": "Field holding the text to score (dot paths allowed)"
        },
        {
          "name": "outputField",
          "displayName": "Output Field",
          "type": "string",
          "default": "sentiment",
          "description": "Field that receives {score, label, matched}"
        }
      ]
    },
    {
      "name": "keywords",
      "displayName": "Keyword Extract",
      "description": "Extract the top-N keywords from a text field, with stopword removal",
      "version": 1,
      "kind": "action",
      "categories": [
        "Text"
      ],
      "icon": "data:image/svg+xml;base64,",
      "color": "#fbbf24",
      "subtitle": "{{mode}} \u00b7 top {{topN}}",
      "inputs": [
        {
          "type": "main"
        }
      ],
      "outputs": [
        {
          "type": "main"
        }
      ],
      "usableAsTool": true,
      "toolDescription": "Extract the most important keywords from a text. Pass the text in the `text` argument (optionally `topN`, default 5). Returns `keywords`, a list of lowercase words ranked by importance with common stopwords removed. Use it to tag, summarize or route documents.",
      "keywords": [
        "keywords",
        "tags",
        "topics",
        "tf-idf",
        "extract",
        "terms"
      ],
      "properties": [
        {
          "name": "field",
          "displayName": "Text Field",
          "type": "string",
          "default": "text",
          "required": true,
          "description": "Field holding the text (dot paths allowed)"
        },
        {
          "name": "topN",
          "displayName": "Top N",
          "type": "number",
          "default": 5,
          "typeOptions": {
            "minValue": 1,
            "maxValue": 100
          },
          "description": "How many keywords to return per item"
        },
        {
          "name": "mode",
          "displayName": "Ranking",
          "type": "options",
          "default": "frequency",
          "noDataExpression": true,
          "options": [
            {
              "name": "Frequency",
              "value": "frequency",
              "description": "Most frequent words in the item"
            },
            {
              "name": "TF-IDF Lite",
              "value": "tfidf-lite",
              "description": "Frequent in this item, rare across all input items"
            }
          ]
        },
        {
          "name": "minCount",
          "displayName": "Minimum Occurrences",
          "type": "number",
          "default": 1,
          "typeOptions": {
            "minValue": 1
          },
          "description": "Ignore words that appear fewer times than this in the item",
          "displayOptions": {
            "show": {
              "mode": [
                "frequency"
              ]
            }
          }
        },
        {
          "name": "tfidfNotice",
          "displayName": "TF-IDF Lite compares items with each other, so send several items (one per document).",
          "type": "notice",
          "default": "",
          "displayOptions": {
            "show": {
              "mode": [
                "tfidf-lite"
              ]
            }
          }
        },
        {
          "name": "language",
          "displayName": "Stopword Language",
          "type": "options",
          "default": "en",
          "typeOptions": {
            "loadOptionsMethod": "languages"
          },
          "description": "Which stopword list to remove"
        },
        {
          "name": "outputField",
          "displayName": "Output Field",
          "type": "string",
          "default": "keywords"
        },
        {
          "name": "includeScores",
          "displayName": "Include Scores",
          "type": "boolean",
          "default": false,
          "description": "Emit [{keyword, score}] instead of plain strings"
        }
      ]
    }
  ]
}