{
  "protocol": "landflow.plugin/v1",
  "plugin": {
    "language": "typescript",
    "sdk": {
      "name": "landflow-sdk-typescript",
      "version": "0.2.0"
    },
    "id": "text-toolkit",
    "name": "Text Toolkit",
    "version": "0.1.0",
    "description": "Slugs, casing, templates and regex extraction",
    "icon": "data:image/svg+xml;base64,",
    "color": "#2563eb",
    "author": "Landflow examples"
  },
  "nodes": [
    {
      "name": "slugify",
      "displayName": "Slugify",
      "description": "Turn text into a URL-safe slug",
      "version": 1,
      "kind": "action",
      "idempotent": true,
      "categories": [
        "Text"
      ],
      "icon": "data:image/svg+xml;base64,",
      "color": "#60a5fa",
      "subtitle": "{{field}} → {{outputField}}",
      "inputs": [
        {
          "type": "main"
        }
      ],
      "outputs": [
        {
          "type": "main"
        }
      ],
      "usableAsTool": true,
      "toolDescription": "Convert a piece of text into a URL slug. Pass the text in the `text` argument.",
      "toolInputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The text to slugify"
          }
        },
        "required": [
          "text"
        ]
      },
      "properties": [
        {
          "name": "field",
          "displayName": "Field",
          "type": "string",
          "default": "text",
          "description": "Item field holding the text"
        },
        {
          "name": "outputField",
          "displayName": "Output Field",
          "type": "string",
          "default": "slug"
        },
        {
          "name": "separator",
          "displayName": "Separator",
          "type": "options",
          "default": "-",
          "options": [
            {
              "name": "Hyphen (-)",
              "value": "-"
            },
            {
              "name": "Underscore (_)",
              "value": "_"
            },
            {
              "name": "Dot (.)",
              "value": "."
            }
          ]
        }
      ]
    },
    {
      "name": "changeCase",
      "displayName": "Change Case",
      "description": "Convert text between upper, lower, title, camel, snake and kebab case",
      "version": 1,
      "kind": "action",
      "idempotent": true,
      "categories": [
        "Text"
      ],
      "icon": "data:image/svg+xml;base64,",
      "color": "#818cf8",
      "subtitle": "{{case}}",
      "inputs": [
        {
          "type": "main"
        }
      ],
      "outputs": [
        {
          "type": "main"
        }
      ],
      "usableAsTool": true,
      "toolDescription": "Change the letter case of text. Arguments: `text` and `case` (upper|lower|title|camel|snake|kebab).",
      "properties": [
        {
          "name": "field",
          "displayName": "Field",
          "type": "string",
          "default": "text"
        },
        {
          "name": "case",
          "displayName": "Case",
          "type": "options",
          "default": "title",
          "options": [
            {
              "name": "Upper",
              "value": "upper"
            },
            {
              "name": "Lower",
              "value": "lower"
            },
            {
              "name": "Title",
              "value": "title"
            },
            {
              "name": "Camel",
              "value": "camel"
            },
            {
              "name": "Snake",
              "value": "snake"
            },
            {
              "name": "Kebab",
              "value": "kebab"
            }
          ]
        },
        {
          "name": "inPlace",
          "displayName": "Replace Field",
          "type": "boolean",
          "default": true,
          "description": "Overwrite the source field instead of writing a new one"
        },
        {
          "name": "outputField",
          "displayName": "Output Field",
          "type": "string",
          "default": "converted",
          "displayOptions": {
            "show": {
              "inPlace": [
                false
              ]
            }
          }
        }
      ]
    },
    {
      "name": "template",
      "displayName": "Render Template",
      "description": "Render a text template per item using [[field]] placeholders",
      "version": 1,
      "kind": "action",
      "idempotent": true,
      "categories": [
        "Text"
      ],
      "icon": "data:image/svg+xml;base64,",
      "color": "#38bdf8",
      "inputs": [
        {
          "type": "main"
        }
      ],
      "outputs": [
        {
          "type": "main"
        }
      ],
      "properties": [
        {
          "name": "notice",
          "displayName": "Placeholders use [[field]] so they do not clash with {{ expressions }}, which the host resolves first.",
          "type": "notice"
        },
        {
          "name": "template",
          "displayName": "Template",
          "type": "string",
          "default": "Hello [[name]]!",
          "typeOptions": {
            "rows": 4
          }
        },
        {
          "name": "outputField",
          "displayName": "Output Field",
          "type": "string",
          "default": "rendered"
        },
        {
          "name": "asFile",
          "displayName": "Also Output as File",
          "type": "boolean",
          "default": false,
          "description": "Whether to also store the rendered text as a binary file (item.binary), e.g. to attach it to an email or upload it"
        },
        {
          "name": "binaryPropertyName",
          "displayName": "Binary Field",
          "type": "string",
          "default": "data",
          "displayOptions": {
            "show": {
              "asFile": [
                true
              ]
            }
          },
          "description": "The item.binary field for the file"
        },
        {
          "name": "fileName",
          "displayName": "File Name",
          "type": "string",
          "default": "rendered.txt",
          "displayOptions": {
            "show": {
              "asFile": [
                true
              ]
            }
          }
        },
        {
          "name": "mimeType",
          "displayName": "MIME Type",
          "type": "string",
          "default": "text/plain",
          "placeholder": "text/html",
          "displayOptions": {
            "show": {
              "asFile": [
                true
              ]
            }
          },
          "description": "text/html, text/csv, application/json, text/markdown…; the text is stored as UTF-8"
        }
      ]
    },
    {
      "name": "regexExtract",
      "displayName": "Regex Extract",
      "description": "Extract every match of a regular expression from a field",
      "version": 1,
      "kind": "action",
      "idempotent": true,
      "categories": [
        "Text"
      ],
      "icon": "data:image/svg+xml;base64,",
      "color": "#a78bfa",
      "subtitle": "/{{pattern}}/",
      "inputs": [
        {
          "type": "main"
        }
      ],
      "outputs": [
        {
          "type": "main"
        }
      ],
      "properties": [
        {
          "name": "source",
          "displayName": "Text From",
          "type": "options",
          "default": "field",
          "options": [
            {
              "name": "JSON Field",
              "value": "field"
            },
            {
              "name": "Binary File",
              "value": "binary",
              "description": "Read a text file of the item (item.binary.<name>, UTF-8)"
            }
          ]
        },
        {
          "name": "field",
          "displayName": "Field",
          "type": "string",
          "default": "text",
          "displayOptions": {
            "show": {
              "source": [
                "field"
              ]
            }
          }
        },
        {
          "name": "binaryPropertyName",
          "displayName": "Input Binary Field",
          "type": "string",
          "default": "data",
          "displayOptions": {
            "show": {
              "source": [
                "binary"
              ]
            }
          },
          "description": "The text file to read (.txt, .csv, .json, .log…)"
        },
        {
          "name": "pattern",
          "displayName": "Pattern",
          "type": "string",
          "default": "[\\w.+-]+@[\\w-]+\\.[\\w.]+",
          "placeholder": "\\d+"
        },
        {
          "name": "flags",
          "displayName": "Flags",
          "type": "string",
          "default": "gi"
        },
        {
          "name": "outputField",
          "displayName": "Output Field",
          "type": "string",
          "default": "matches"
        },
        {
          "name": "splitMatches",
          "displayName": "One Item per Match",
          "type": "boolean",
          "default": false
        }
      ]
    }
  ]
}