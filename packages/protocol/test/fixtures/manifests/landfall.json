              "action": "Open an incident manually"
            },
            {
              "name": "Open From Alert",
              "value": "openFromAlert",
              "description": "Send an alert to Landfall; it opens a room, attaches to an open one with the same dedup key, or ignores it",
              "action": "Open an incident from an alert"
            },
            {
              "name": "Recover",
              "value": "recover",
              "description": "Send the recovery of an alert; Landfall records it but never closes the room",
              "action": "Send an alert recovery"
