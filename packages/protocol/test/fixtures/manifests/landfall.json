              "name": "Declare",
              "value": "declare",
              "description": "Declare an incident (POST /incidents)",
              "action": "Declare an incident"
            },
            {
              "name": "Get",
              "value": "get",
              "description": "Get the folded state of an incident",
              "action": "Get an incident",
              "idempotent": true
            },
            {
              "name": "Get Room",
              "value": "getRoom",
              "description": "The incident and its whole timeline in one item: the input of Landflow's \"Make a runbook\" (POST /api/runbooks/draft)",
              "action": "Get a room with its timeline",
              "idempotent": true
            },
            {
              "name": "Get Many",
