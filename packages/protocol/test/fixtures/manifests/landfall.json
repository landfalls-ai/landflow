    {
      "name": "landfallTrigger",
      "displayName": "Landfall Trigger",
      "description": "Starts the workflow when Landfall opens an incident, an incident ends, or a room gets timeline events (polls the Landfall API, no public URL needed)",
      "version": 1,
      "kind": "trigger",
      "triggerSource": "poll",
      "categories": [
        "Development",
        "Communication"
      ],
      "icon": "data:image/svg+xml;base64,",
      "color": "#3B5B7A",
      "subtitle": "every {{pollInterval}}s",
      "documentationUrl": "https://landfalls.ai",
      "keywords": [
        "landfall",
        "incident",
        "war room",
        "trigger",
        "timeline"
      ],
      "inputs": [],
      "outputs": [
        {
          "type": "main"
        }
      ],
      "credentials": [
        {
          "name": "landfallApi",
          "required": true
        }
      ],
      "properties": [
        {
          "name": "pollInterval",
          "displayName": "Poll Interval (seconds)",
          "type": "number",
          "default": 30,
          "description": "How often to check for new events while the workflow is active",
          "noDataExpression": true,
          "typeOptions": {
            "minValue": 10,
            "numberPrecision": 0
          }
        },
        {
          "name": "events",
          "displayName": "Trigger On",
          "type": "multiOptions",
          "default": [
            "incidentOpened"
          ],
          "options": [
            {
              "name": "New Incident",
              "value": "incidentOpened",
              "description": "An incident with a number above the last one seen"
            },
            {
              "name": "Incident Ended",
              "value": "incidentEnded",
              "description": "An incident seen open now has an ended status (resolved, closed, mitigated, recovered, done, archived)"
