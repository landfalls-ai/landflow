    "id": "landfall",
    "name": "Landfall",
    "version": "0.1.0",
    "description": "Landfall incident response: open, attach and recover incidents from alerts, read rooms, add events and notes, record fixes applied outside Landfall, heartbeats and a trigger; reachable over HTTP, gRPC, any installed broker and MCP",
    "icon": "data:image/svg+xml;base64,",
    "color": "#3B5B7A",
    "author": "Landflow"
  },
  "nodes": [
    {
      "name": "landfall",
      "displayName": "Landfall",
      "description": "Open, attach and recover Landfall incidents from alerts, read rooms and timelines, add events and notes, record fixes applied outside Landfall and ping heartbeats",
      "version": 1,
      "kind": "action",
      "categories": [
        "Development",
        "Communication"
      ],
      "icon": "data:image/svg+xml;base64,",
      "color": "#3B5B7A",
      "subtitle": "{{operation}}: {{resource}}",
      "documentationUrl": "https://landfalls.ai",
      "keywords": [
        "landfall",
        "incident",
        "war room",
        "alert",
        "oncall",
        "runbook",
        "heartbeat"
      ],
      "usableAsTool": true,
      "idempotent": false,
      "toolDescription": "Landfall incident response: open an incident from an alert (deduplicated by dedupKey) or recover it, declare an incident, read an incident's state, list incidents, read or append timeline events and notes, record that a suggested remediation was applied outside Landfall, and ping a heartbeat.",
      "inputs": [
        {
          "type": "main"
        }
      ],
      "outputs": [
        {
          "type": "main"
        }
      ],
      "credentials": [
        {
          "name": "landfallApi",
          "required": true,
          "displayOptions": {
            "hide": {
              "resource": [
                "heartbeat"
              ]
            }
          }
        },
        {
          "name": "landfallHeartbeatApi",
          "required": true,
          "displayOptions": {
            "show": {
              "resource": [
                "heartbeat"
              ]
            }
          }
        }
      ],
      "properties": [
