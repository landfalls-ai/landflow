{
  "protocol": "landflow.plugin/v1",
  "plugin": {
    "id": "go-crypto",
    "name": "Crypto Toolkit",
    "version": "0.1.0",
    "description": "Hashing, UUIDs, Base64 and JWT decoding: the example plugin for the Landflow Go SDK.",
    "language": "go",
    "sdk": {
      "name": "landflow-sdk-go",
      "version": "0.2.0"
    },
    "icon": "data:image/svg+xml;base64,",
    "color": "#0d9488",
    "author": "Landflow"
  },
  "nodes": [
    {
      "name": "hash",
      "displayName": "Hash",
      "description": "Hash a field with SHA-256, SHA-1, SHA-512 or MD5",
      "version": 1,
      "kind": "action",
      "categories": [
        "Crypto"
      ],
      "icon": "data:image/svg+xml;base64,",
      "color": "#22d3ee",
      "subtitle": "{{algorithm}}",
      "inputs": [
        {
          "type": "main"
        }
      ],
      "outputs": [
        {
          "type": "main"
        }
      ],
      "properties": [
        {
          "name": "algorithm",
          "displayName": "Algorithm",
          "type": "options",
          "default": "sha256",
          "description": "Digest algorithm",
          "options": [
            {
              "name": "SHA-256",
              "value": "sha256",
              "description": "256-bit SHA-2 digest (recommended)"
            },
            {
              "name": "SHA-1",
              "value": "sha1",
              "description": "160-bit digest; legacy, not collision-resistant"
            },
            {
              "name": "SHA-512",
              "value": "sha512",
              "description": "512-bit SHA-2 digest"
            },
            {
              "name": "MD5",
              "value": "md5",
              "description": "128-bit digest; checksums only, not secure"
            }
          ],
          "typeOptions": {
            "loadOptionsMethod": "algorithms"
          }
        },
        {
          "name": "field",
          "displayName": "Field",
          "type": "string",
          "default": "value",
          "description": "Input field to hash. Dots reach nested fields (user.email); non-string values are hashed as JSON.",
          "placeholder": "value",
          "required": true
        },
        {
          "name": "encoding",
          "displayName": "Encoding",
          "type": "options",
          "default": "hex",
          "options": [
            {
              "name": "Hex",
              "value": "hex",
              "description": "Lower-case hexadecimal"
            },
            {
              "name": "Base64",
              "value": "base64",
              "description": "Standard Base64 with padding"
            }
          ]
        },
        {
          "name": "outputField",
          "displayName": "Output Field",
          "type": "string",
          "default": "hash",
          "description": "Field that receives the digest"
        }
      ],
      "usableAsTool": true,
      "toolDescription": "Compute a cryptographic digest of a text. Pass the text in `value`; optionally choose `algorithm` (sha256 default, sha1, sha512, md5) and `encoding` (hex default, base64). Returns the digest in the `hash` field. Use it for checksums, fingerprints or cache keys; it is a one-way function and cannot be reversed.",
      "toolInputSchema": {
        "properties": {
          "algorithm": {
            "default": "sha256",
            "enum": [
              "sha256",
              "sha1",
              "sha512",
              "md5"
            ],
            "type": "string"
          },
          "encoding": {
            "default": "hex",
            "enum": [
              "hex",
              "base64"
            ],
            "type": "string"
          },
          "value": {
            "description": "The text to hash",
            "type": "string"
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
      "keywords": [
        "digest",
        "checksum",
        "sha256",
        "sha1",
        "sha512",
        "md5",
        "fingerprint"
      ]
    },
    {
      "name": "uuid",
      "displayName": "UUID",
      "description": "Add a random UUID (v4) to every item, or generate new items holding UUIDs",
      "version": 1,
      "kind": "action",
      "categories": [
        "Crypto"
      ],
      "icon": "data:image/svg+xml;base64,",
      "color": "#2dd4bf",
      "subtitle": "{{mode}}",
      "inputs": [
        {
          "type": "main"
        }
      ],
      "outputs": [
        {
          "type": "main"
        }
      ],
      "properties": [
        {
          "name": "mode",
          "displayName": "Mode",
          "type": "options",
          "default": "addToItems",
          "noDataExpression": true,
          "options": [
            {
              "name": "Add to Items",
              "value": "addToItems",
              "description": "Add a UUID field to every incoming item",
              "action": "Add a UUID to each item"
            },
            {
              "name": "Generate",
              "value": "generate",
              "description": "Emit new items, one UUID each",
              "action": "Generate UUIDs"
            }
          ]
        },
        {
          "name": "count",
          "displayName": "Count",
          "type": "number",
          "default": 1,
          "description": "How many UUIDs to generate",
          "typeOptions": {
            "minValue": 1,
            "maxValue": 1000,
            "numberPrecision": 0
          },
          "displayOptions": {
            "show": {
              "mode": [
                "generate"
              ]
            }
          }
        },
        {
          "name": "outputField",
          "displayName": "Output Field",
          "type": "string",
          "default": "uuid",
          "description": "Field that receives the UUID"
        }
      ],
      "usableAsTool": true,
      "toolDescription": "Generate random RFC 9562 version-4 UUIDs. To get several, set `mode` to \"generate\" and `count` to how many you need (max 1000); each result item has a `uuid` field. With the default mode a single `uuid` is returned.",
      "toolInputSchema": {
        "properties": {
          "count": {
            "default": 1,
            "description": "How many UUIDs (generate mode)",
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "mode": {
            "default": "addToItems",
            "enum": [
              "addToItems",
              "generate"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "keywords": [
        "uuid",
        "guid",
        "random",
        "identifier",
        "id"
      ]
    },
    {
      "name": "base64",
      "displayName": "Base64",
      "description": "Encode a field to Base64 or decode it back to text",
      "version": 1,
      "kind": "action",
      "categories": [
        "Crypto"
      ],
      "icon": "data:image/svg+xml;base64,",
      "color": "#06b6d4",
      "subtitle": "{{operation}}",
      "inputs": [
        {
          "type": "main"
        }
      ],
      "outputs": [
        {
          "type": "main"
        }
      ],
      "properties": [
        {
          "name": "operation",
          "displayName": "Operation",
          "type": "options",
          "default": "encode",
          "noDataExpression": true,
          "options": [
            {
              "name": "Encode",
              "value": "encode",
              "description": "Text \u2192 Base64",
              "action": "Encode a field to Base64"
            },
            {
              "name": "Decode",
              "value": "decode",
              "description": "Base64 \u2192 text",
              "action": "Decode a Base64 field"
            }
          ]
        },
        {
          "name": "field",
          "displayName": "Field",
          "type": "string",
          "default": "value",
          "description": "Input field to transform. Dots reach nested fields; non-string values are encoded as JSON.",
          "required": true
        },
        {
          "name": "urlSafe",
          "displayName": "URL-Safe Alphabet",
          "type": "boolean",
          "default": false,
          "description": "Use - and _ instead of + and / and drop the padding (RFC 4648 \u00a75)",
          "displayOptions": {
            "show": {
              "operation": [
                "encode"
              ]
            }
          }
        },
        {
          "name": "outputField",
          "displayName": "Output Field",
          "type": "string",
          "default": "",
          "placeholder": "same as Field",
          "hint": "Leave empty to overwrite the input field"
        }
      ],
      "keywords": [
        "base64",
        "encode",
        "decode",
        "btoa",
        "atob"
      ]
    },
    {
      "name": "jwtDecode",
      "displayName": "JWT Decode",
      "description": "Decode a JWT's header and payload (the signature is not verified)",
      "version": 1,
      "kind": "action",
      "categories": [
        "Crypto"
      ],
      "icon": "data:image/svg+xml;base64,",
      "color": "#14b8a6",
      "inputs": [
        {
          "type": "main"
        }
      ],
      "outputs": [
        {
          "type": "main"
        }
      ],
      "properties": [
        {
          "name": "notice",
          "displayName": "The signature is NOT verified. Decoded claims can be forged \u2014 never use them on their own for authentication or authorization decisions.",
          "type": "notice",
          "default": ""
        },
        {
          "name": "field",
          "displayName": "Token Field",
          "type": "string",
          "default": "token",
          "description": "Input field holding the JWT. A leading \"Bearer \" is stripped.",
          "required": true
        },
        {
          "name": "outputField",
          "displayName": "Output Field",
          "type": "string",
          "default": "jwt",
          "description": "Field that receives { header, payload, expiresAt, expired, signatureVerified }"
        }
      ],
      "usableAsTool": true,
      "toolDescription": "Decode a JSON Web Token (JWT) WITHOUT verifying its signature. Pass the token in `token` (a leading \"Bearer \" is fine). Returns `jwt.header`, `jwt.payload` (the claims), `jwt.expiresAt` (ISO 8601, from the exp claim, or null) and `jwt.expired`. Use it to inspect claims only; never treat the result as proof that the token is authentic.",
      "toolInputSchema": {
        "properties": {
          "token": {
            "description": "The JWT to decode",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "keywords": [
        "jwt",
        "token",
        "claims",
        "bearer",
        "decode",
        "exp"
      ]
    }
  ]
}