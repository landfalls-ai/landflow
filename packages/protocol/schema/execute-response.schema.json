{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outputs": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "json": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "binary": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[\\w-]{1,64}\\.[\\w-]{8,64}$"
                  },
                  "mimeType": {
                    "type": "string"
                  },
                  "fileName": {
                    "type": "string"
                  },
                  "fileExtension": {
                    "type": "string"
                  },
                  "fileSize": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "fileType": {
                    "type": "string",
                    "enum": [
                      "image",
                      "text",
                      "json",
                      "html",
                      "pdf",
                      "audio",
                      "video",
                      "other"
                    ]
                  },
                  "data": {
                    "type": "string"
                  }
                },
                "required": [
                  "mimeType"
                ],
                "additionalProperties": false
              }
            },
            "pairedItem": {
              "type": "object",
              "properties": {
                "item": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "input": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "item"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "json"
          ],
          "additionalProperties": false
        }
      }
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "debug",
              "info",
              "warn",
              "error"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "level",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "error": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "itemIndex": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "pollState": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "records": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "artifact"
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "data": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "at": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "check"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "warn",
                  "skip"
                ]
              },
              "message": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "evidence": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "at": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "name",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "model"
              },
              "name": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "inputTokens": {
                "type": "number",
                "minimum": 0
              },
              "outputTokens": {
                "type": "number",
                "minimum": 0
              },
              "cacheReadTokens": {
                "type": "number",
                "minimum": 0
              },
              "cacheWriteTokens": {
                "type": "number",
                "minimum": 0
              },
              "durationMs": {
                "type": "number",
                "minimum": 0
              },
              "finishReason": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "model",
              "provider",
              "inputTokens",
              "outputTokens"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "outputs"
  ],
  "additionalProperties": false
}
