{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "landflow.plugin/v1"
    },
    "method": {
      "type": "string",
      "enum": [
        "checkExists",
        "create",
        "delete"
      ]
    },
    "workflowId": {
      "type": "string"
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "typeVersion": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "typeVersion"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "credentials": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "webhookUrl": {
      "type": "string"
    },
    "staticData": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "protocol",
    "method",
    "workflowId",
    "node",
    "parameters",
    "webhookUrl",
    "staticData"
  ],
  "additionalProperties": false
}
