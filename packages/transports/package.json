  "devDependencies": {
    "@aws-sdk/client-sqs": "3.1156.0",
    "@azure/service-bus": "7.10.0",
    "@confluentinc/kafka-javascript": "1.11.0",
    "@google-cloud/pubsub": "6.3.1",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@types/node": "^22.20.5",
    "amqplib": "2.2.0",
