{
  "name": "@landflow/transports",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Landflow generic messaging over brokers: the CloudEvents envelope, signing and encryption, the host client and plugin server, the broker driver contract, an in-memory driver and the driver conformance suite.",
  "exports": {
    ".": "./src/index.ts",
    "./driver": "./src/driver.ts",
    "./drivers": "./src/drivers/index.ts",
    "./memory": "./src/memory/index.ts",
    "./kafka": "./src/drivers/kafka/index.ts",
    "./amqp": "./src/drivers/amqp/index.ts",
    "./nats": "./src/drivers/nats/index.ts",
    "./jetstream": "./src/drivers/nats/jetstream.ts",
    "./valkey": "./src/drivers/valkey/index.ts",
    "./sqs": "./src/drivers/sqs/index.ts",
    "./pubsub": "./src/drivers/pubsub/index.ts",
    "./pulsar": "./src/drivers/pulsar/index.ts",
    "./servicebus": "./src/drivers/servicebus/index.ts",
    "./mqtt": "./src/drivers/mqtt/index.ts",
    "./amqp1": "./src/drivers/amqp1/index.ts",
    "./conformance": "./src/conformance/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@landflow/protocol": "workspace:*"
  },
  "peerDependencies": {
    "@aws-sdk/client-sqs": "3.1156.0",
