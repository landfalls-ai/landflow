{
  "name": "@landflow/sdk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Landflow TypeScript SDK: implement INodeType, serve it over HTTP (with the MCP face at /mcp), gRPC, any broker (and any TransportBinding), announce it to the registry.",
  "exports": {
    ".": "./src/index.ts",
    "./binding": "./src/binding.ts",
    "./dispatcher": "./src/dispatcher.ts",
    "./http": "./src/http.ts",
    "./grpc": "./src/grpc.ts",
    "./announce": "./src/announce.ts",
    "./serve": "./src/serve.ts",
    "./telemetry": "./src/telemetry.ts",
    "./messaging": "./src/messaging.ts",
    "./mcp": "./src/mcp.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@landflow/protocol": "workspace:*",
    "@landflow/transports": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-prometheus": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.20.5",
    "vitest": "^5.0.5"
  }
}
