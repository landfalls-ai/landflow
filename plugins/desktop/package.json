{
  "name": "@landflow/plugin-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop plugin: see and use a disposable virtual desktop (screenshot, click, type, key, scroll) in a locked-down container.",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@landflow/sdk": "workspace:*",
    "@landflow/transports": "workspace:*"
  },
  "devDependencies": {
    "@landflow/protocol": "workspace:*",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
