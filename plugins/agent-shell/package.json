{
  "name": "@landflow/plugin-agent-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent Shell plugin: a simulated bash over an in-memory filesystem (just-bash), as an agent tool.",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@landflow/sdk": "workspace:*",
    "@landflow/transports": "workspace:*",
    "just-bash": "3.6.0"
  },
  "devDependencies": {
    "@landflow/protocol": "workspace:*",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
