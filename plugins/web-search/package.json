{
  "name": "@landflow/plugin-web-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web Search plugin: search the web through SearXNG, Brave Search or Tavily and return titles, links and snippets. Usable as an agent tool.",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@landflow/sdk": "workspace:*",
    "@landflow/transports": "workspace:*"
  },
  "devDependencies": {
    "@landflow/protocol": "workspace:*",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
