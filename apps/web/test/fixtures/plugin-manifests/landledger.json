{
 "protocol": "landflow.plugin/v1",
 "plugin": {
  "language": "typescript",
  "sdk": {
   "name": "landflow-sdk-typescript",
   "version": "0.2.0"
  },
  "id": "landledger",
  "name": "Landledger",
  "version": "0.1.0",
  "description": "Landledger cost ledger: budgets, spend, requests, reservations and periods, a person's decision relayed from Slack, Teams or email, and a webhook trigger for requests, budgets and periods; reachable over HTTP, gRPC, any installed broker and MCP",
  "icon": "data:image/svg+xml;base64,",
  "color": "#2F7D5B",
  "author": "Landflow"
 },
 "nodes": [
  {
   "name": "landledger",
   "displayName": "Landledger",
   "description": "Check a cost center's budget, query spend, raise and read spend requests, reserve and release budget, read a month's status, and relay a person's approval in Landledger",
   "version": 1,
   "kind": "action",
   "categories": [
    "Finance",
    "Productivity"
   ],
   "icon": "data:image/svg+xml;base64,",
   "color": "#2F7D5B",
   "subtitle": "{{operation}}: {{resource}}",
   "documentationUrl": "https://github.com/landfalls-ai/landflow/blob/main/plugins/landledger/README.md",
   "keywords": [
    "landledger",
    "finance",
    "budget",
    "cost",
    "spend",
    "approval",
    "request",
    "reservation",
    "finops",
    "ledger"
   ],
   "usableAsTool": true,
   "idempotent": false,
   "toolDescription": "Landledger, the cost ledger: check what a cost center has left this month after actuals and reservations (and whether a planned amount fits), query spend grouped by cost center, team, service, agent, model…, raise a spend request (an agent always names its sponsor, the accountable person) and read its status and evidence, reserve or release budget for an approved request, and read whether a month is open, closing or locked. Agents request; people decide: no tool here approves or rejects.",
   "inputs": [
    {
     "type": "main"
    }
   ],
   "outputs": [
    {
     "type": "main"
    }
   ],
   "credentials": [
    {
     "name": "landledgerApi",
     "required": true
    }
   ],
   "properties": [
    {
     "name": "resource",
     "displayName": "Resource",
