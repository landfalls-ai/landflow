      {
       "name": "Request Decided",
       "value": "request.decided",
       "description": "A request ended: approved, rejected, cancelled or expired"
      },
      {
       "name": "Request Applied",
       "value": "request.applied",
       "description": "The approved change is in place"
      },
      {
       "name": "Budget at Risk",
       "value": "budget.at_risk",
       "description": "A cost center crossed into at risk or over in a month"
      },
      {
       "name": "Period Closing",
       "value": "period.closing",
       "description": "A month starts closing"
      },
      {
       "name": "Request Created",
       "value": "request.created",
       "description": "A request was submitted"
      }
     ]
    },
