  {
   "name": "landledgerTrigger",
   "displayName": "Landledger Trigger",
   "description": "Starts the workflow when a Landledger request waits on its approvers, is decided or applied, a budget is at risk, or a month starts closing (a signed webhook)",
   "version": 1,
   "kind": "trigger",
   "triggerSource": "appWebhook",
   "categories": [
    "Finance",
    "Productivity"
   ],
   "icon": "data:image/svg+xml;base64,",
   "color": "#2F7D5B",
   "subtitle": "{{events}}",
   "documentationUrl": "https://github.com/landfalls-ai/landflow/blob/main/plugins/landledger/README.md",
   "keywords": [
    "landledger",
    "approval",
    "request",
    "decided",
    "budget",
    "webhook",
    "finance",
    "trigger"
   ],
   "inputs": [],
   "outputs": [
    {
     "type": "main"
    }
   ],
   "credentials": [
    {
     "name": "landledgerApi",
     "required": true
    }
   ],
   "properties": [
    {
     "name": "notice",
     "displayName": "Publishing the workflow subscribes it in Landledger (POST /api/webhooks; Landledger lets only an admin key manage webhooks) and keeps the signing secret for you; unpublishing deletes the subscription. Without an admin key, have a Landledger admin add a webhook for this node's URL (Publish menu → App webhooks) with these events, and put its whsec_ secret in the credential's Webhook Signing Secret: then nothing is registered. Landledger must reach Landflow at the published URL (LANDFLOW_PUBLIC_URL). Every delivery is checked against its Standard Webhooks signature.",
     "type": "notice",
     "default": ""
    },
    {
     "name": "events",
     "displayName": "Trigger On",
     "type": "multiOptions",
     "default": [
      "request.step_pending",
      "request.decided",
      "request.applied",
      "budget.at_risk",
      "period.closing"
     ],
     "options": [
      {
       "name": "Request Step Pending",
       "value": "request.step_pending",
       "description": "A step starts waiting on its approvers (or escalates): who they are, the evidence hash to relay with"
