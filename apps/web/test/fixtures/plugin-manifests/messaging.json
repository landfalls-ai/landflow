  {
   "name": "telegramTrigger",
   "displayName": "Telegram Trigger",
   "description": "Starts the workflow when the bot receives Telegram updates (polls getUpdates, no public URL needed)",
   "version": 1,
   "kind": "trigger",
   "triggerSource": "poll",
   "categories": [
    "Communication"
   ],
   "color": "#229ED9",
   "subtitle": "every {{pollInterval}}s",
   "documentationUrl": "https://core.telegram.org/bots/api#getupdates",
   "keywords": [
    "telegram",
    "bot",
    "trigger",
    "updates",
    "getUpdates"
   ],
   "inputs": [],
   "outputs": [
    {
     "type": "main"
    }
   ],
   "credentials": [
    {
     "name": "telegramApi",
     "required": true
    }
   ],
   "properties": [
    {
     "name": "pollInterval",
     "displayName": "Poll Interval (seconds)",
     "type": "number",
     "default": 30,
     "description": "How often to check for new events while the workflow is active",
     "noDataExpression": true,
     "typeOptions": {
      "minValue": 10,
      "numberPrecision": 0
     }
    },
    {
     "name": "updates",
     "displayName": "Trigger On",
     "type": "multiOptions",
     "default": [
      "message"
     ],
     "options": [
      {
       "name": "*",
       "value": "*",
       "description": "All update types Telegram sends by default"
      },
      {
       "name": "Message",
       "value": "message",
       "description": "New incoming message of any kind: text, photo, sticker\u2026"
      },
      {
       "name": "Edited Message",
       "value": "edited_message"
      },
      {
       "name": "Channel Post",
       "value": "channel_post",
       "description": "New post in a channel the bot is an admin of"
      },
      {
       "name": "Callback Query",
       "value": "callback_query",
       "description": "A user pressed an inline keyboard button"
      }
     ]
    },
    {
     "name": "notice",
     "displayName": "Polls getUpdates, so the bot must have no webhook (Telegram answers 409 otherwise: call deleteWebhook first). Only one poller per bot. Execute in the editor shows up to 5 recent updates without consuming them.",
     "type": "notice"
    }
   ]
  },
