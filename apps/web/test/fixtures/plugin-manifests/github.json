   "usableAsTool": true,
   "toolDescription": "Do a GitHub step over the REST API: get a repository or compare two branches, read or list files, create or update one file, commit several files in one commit (optionally on a new branch), create or get a branch, open a draft pull request, list its files, comment on a pull request or issue, merge a pull request, create an issue. It cannot delete.",
   "documentationUrl": "https://docs.github.com/en/rest",
   "keywords": [
    "github",
    "git",
    "repository",
    "commit",
    "branch",
    "pull request",
    "pr",
    "merge",
    "issue",
    "file"
   ],
   "credentials": [
    {
     "name": "githubApi",
     "required": true
    }
   ],
   "idempotent": false
  }
 ],
 "credentialTypes": [
  {
   "name": "githubApi",
   "displayName": "GitHub API",
   "description": "A personal access token (classic with the repo scope, or fine-grained with Contents, Pull requests and Issues read and write on the repositories). For GitHub Enterprise Server use https://<host>/api/v3 as the API base URL.",
   "icon": "data:image/svg+xml;base64,",
   "documentationUrl": "https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens",
   "properties": [
    {
     "name": "accessToken",
     "displayName": "Access Token",
     "type": "string",
     "description": "A personal access token, or an installation token of a GitHub App",
     "placeholder": "ghp_\u2026 / github_pat_\u2026",
     "required": true,
     "typeOptions": {
      "password": true
     }
    },
    {
     "name": "baseUrl",
     "displayName": "API Base URL",
     "type": "string",
     "default": "https://api.github.com",
     "description": "GitHub Enterprise Server: https://<host>/api/v3. Change it otherwise only for a proxy or a test double"
    }
   ],
   "testable": true
  }
 ]
