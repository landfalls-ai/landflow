  {
    "label": "config.toml",
    "language": "toml",
    "text": "[mcp_servers.landflow]
url = "https://landflow.example.test/api/mcp"
http_headers = { Authorization = "Bearer lf_made-up-test-key-0123456789" }",
    "where": "~/.codex/config.toml",
  },
]
`;

