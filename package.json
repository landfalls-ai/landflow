{
  "name": "landflow",
  "private": true,
  "description": "Landflow \u2014 a low-code workflow platform with autodiscovered, polyglot node plugins.",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @landflow/web dev",
    "build": "pnpm --filter @landflow/web build",
    "start": "pnpm --filter @landflow/web start",
    "worker": "pnpm --filter @landflow/web worker",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "landflow": "node packages/cli/dist/main.js",
    "gen:proto": "pnpm --filter @landflow/protocol gen:proto && pnpm --filter @landflow/protocol gen:schema",
    "plugin:ts": "pnpm --filter @landflow/plugin-text-toolkit start",
    "plugin:py": "cd plugins/py-insights && (test -x .venv/bin/python && .venv/bin/python main.py || python3 main.py)",
    "plugin:go": "cd plugins/go-crypto && go run .",
    "plugin:messaging": "pnpm --filter @landflow/plugin-messaging start",
    "plugin:productivity": "cd plugins/productivity && (test -x .venv/bin/python && .venv/bin/python main.py || python3 main.py)",
    "plugin:google": "cd plugins/google-workspace && go run .",
    "plugin:databases": "cd plugins/databases && go run .",
    "plugin:landfall": "pnpm --filter @landflow/plugin-landfall start",
    "plugin:triage": "pnpm --filter @landflow/plugin-triage start",
    "plugin:threat-intel": "cd plugins/threat-intel && go run .",
    "fake-landfall": "pnpm --filter @landflow/plugin-landfall fake-landfall",
    "dev:all": "concurrently -k -n web,ts,py,go,msg,prod,google,db -c magenta,blue,yellow,cyan,green,red,white,gray \"pnpm dev\" \"pnpm plugin:ts\" \"pnpm plugin:py\" \"pnpm plugin:go\" \"pnpm plugin:messaging\" \"pnpm plugin:productivity\" \"pnpm plugin:google\" \"pnpm plugin:databases\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3"
  }
}
